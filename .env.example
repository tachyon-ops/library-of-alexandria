# Postgres connection used by the web app, the worker and the migration script
DATABASE_URL=postgres://library:library@localhost:5432/library

# AI provider ("anthropic" or "gemini"). Auto-detected from whichever key is set if left blank.
LLM_PROVIDER=

# API key: set AI_API_KEY for the active provider, or set the provider-specific key below
AI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides per role.
# Defaults (anthropic): scout=claude-sonnet-5-5, reader=claude-haiku-5-5, skeptic=claude-opus-5-5, web=claude-sonnet-5-5
# Defaults (gemini):    scout=gemini-2.5-pro,    reader=gemini-2.5-flash, skeptic=gemini-2.5-pro,  web=gemini-2.5-flash
MODEL_SCOUT=
MODEL_READER=
MODEL_SKEPTIC=
MODEL_WEB=

# Contact address sent to OpenAlex and NCBI-style APIs (their "polite pool")
CONTACT_EMAIL=

# Cost guards for the worker
MAX_LLM_CALLS_PER_DAY=400
MAX_WEB_SEARCHES_PER_JOB=8
SOURCES_PER_QUERY=10
# Abstracts read per topic per research run (10 per reader call)
MAX_SOURCES_PER_TOPIC=60
# How many levels of subtopics are researched automatically below a topic you start
AUTO_EXPAND_DEPTH=1
WORKER_POLL_MS=3000
