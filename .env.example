# ============================================================================
# Alexander's Library — Environment Configuration (.env.example)
# ============================================================================
# Rules:
# 1. Copy `env.template` (or `.env.example`) to `.env` at the repository root.
# 2. Never commit `.env` or real API keys to git (`.env` is git-ignored).
# 3. Choose ONE AI provider:
#    - Set `LLM_PROVIDER=gemini` and provide `GEMINI_API_KEY` (or `AI_API_KEY`), OR
#    - Set `LLM_PROVIDER=anthropic` and provide `ANTHROPIC_API_KEY` (or `AI_API_KEY`).
#    - If `LLM_PROVIDER` is left blank, it is auto-detected from whichever key is set.
# 4. Leave `MODEL_*` blank to use the recommended defaults for the active provider:
#    - gemini:    scout=gemini-3.6-flash, reader=gemini-3.6-flash, skeptic=gemini-3.6-flash, web=gemini-3.6-flash
#    - anthropic: scout=claude-sonnet-5-5, reader=claude-haiku-5-5, skeptic=claude-opus-5-5, web=claude-sonnet-5-5
# 5. Always set `CONTACT_EMAIL` so Europe PMC and OpenAlex place requests in their
#    polite pool (higher rate limits).
# 6. Keep cost guards enabled; raising them requires explicit review.
# ============================================================================

# Postgres connection used by the web app, the worker and the migration script
DATABASE_URL=postgres://library:library@localhost:5432/library

# AI provider ("gemini" or "anthropic")
LLM_PROVIDER=gemini

# API key for the selected provider
AI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides per role (leave blank for provider defaults)
MODEL_SCOUT=
MODEL_READER=
MODEL_SKEPTIC=
MODEL_WEB=

# Contact address sent to OpenAlex and NCBI-style APIs (their "polite pool")
CONTACT_EMAIL=

# Optional: free OpenAlex API key (https://help.openalex.org/api/authentication/)
# Recommended: avoids 429 IP-pool budget caps on shared networks
OPENALEX_API_KEY=

# Cost guards for the worker
MAX_LLM_CALLS_PER_DAY=400
MAX_WEB_SEARCHES_PER_JOB=8
SOURCES_PER_QUERY=10
# Abstracts read per topic per research run (10 per reader call)
MAX_SOURCES_PER_TOPIC=60
# How many levels of subtopics are researched automatically below a topic you start
AUTO_EXPAND_DEPTH=1
WORKER_POLL_MS=3000
# Set to 1 (or pass --drain) to drain the queue and exit (used by GitHub Actions worker)
WORKER_DRAIN=

# Optional: trigger GitHub Actions worker.yml immediately from Vercel web actions
GITHUB_REPO=tachyon-ops/library-of-alexandria
GITHUB_REF=master
GITHUB_DISPATCH_TOKEN=
